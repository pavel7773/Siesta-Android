<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <!-- Резервное копирование в облако -->
    <cloud-backup>
        <!-- Не сохраняем JWT и данные авторизации -->
        <exclude
            domain="file"
            path="datastore/" />
    </cloud-backup>

    <!-- Перенос данных между устройствами -->
    <device-transfer>
        <!-- Не переносим защищённые сессии -->
        <exclude
            domain="file"
            path="datastore/" />
    </device-transfer>

</data-extraction-rules>
